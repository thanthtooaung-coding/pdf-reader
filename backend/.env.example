# ----------------------------------------------------------------------
# pdf-reader backend — environment template
# Copy to .env and fill in real values.
# ----------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=info
PORT=8080

DATABASE_URL=postgres://pdfreader:pdfreader@localhost:5432/pdfreader?sslmode=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MIN=30
DB_AUTO_MIGRATE=true

JWT_SECRET=change-me-in-production
JWT_EXPIRES_HOURS=24

SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_EMAIL=admin@pdfreader.local
DEFAULT_ADMIN_PASSWORD=PdfAdmin123@

REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

OTP_TTL_SECONDS=600
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_RATE_LIMIT_MAX=3
OTP_RATE_LIMIT_WINDOW_MIN=15
OTP_DEBUG_RETURN=true

RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
EMAIL_FROM=noreply@example.com

STORAGE_PATH=./storage
MAX_UPLOAD_MB=25

CORS_ALLOW_ORIGINS=*
